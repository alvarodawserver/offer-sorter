# Copy this file to .env and replace the placeholder values.
# .env is git-ignored; never commit real credentials.

# Used by the PostgreSQL container to create the user and the database.
POSTGRES_USER=job_analyzer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=job_analyzer

# Used by the app to connect: driver://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://job_analyzer:change-me@localhost:5432/job_analyzer
